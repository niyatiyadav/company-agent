# Copy this file to .env and fill in your real key. .env is gitignored and
# never committed. When deploying, add the same variable in the Vercel
# project's Settings → Environment Variables instead.

VITE_FMP_API_KEY=your_fmp_key_here

# Optional: only needed if you re-enable the AI-summary layer described in
# the README's "Optional: AI-written summary" section. Not required to run
# the app as shipped.
# VITE_ANTHROPIC_API_KEY=your_anthropic_key_here
